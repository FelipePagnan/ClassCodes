@model List<Livro>

<h1>Biblioteca</h1>

@if (TempData["Sucesso"] != null)
{
    <div class="alert alert-success" role="alert">
        @TempData["Sucesso"]
    </div>
}
@if (TempData["Erro"] != null)
{
    <div class="alert alert-danger" role="alert">
        @TempData["Erro"]
    </div>
}

<a asp-controller="Biblioteca" asp-action="Registrar" class="btn btn-primary">Registrar Livro</a>

<table class="table table-striped tabela-livros">
    <thead>
        <tr>
            <th scope="col">#</th>
            <th scope="col">Título</th>
            <th scope="col">Autor</th>
            <th scope="col">ISBN</th>
            <th scope="col">Ano de Publicação</th>
            <th scope="col">Nota do Livro</th>
            <th scope="col">Ações</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <th scope="row">@item.Id</th>
                <td>@item.Titulo</td>
                <td>@item.Autor</td>
                <td>@item.ISBN</td>
                <td>@item.AnoPublicacao</td>
                <td>@((int)item.NotaDoLivro)</td>
                <td>
                    <a href="" title="Detalhes" data-bs-toggle="modal" data-bs-target="#Modal_@item.Id" class="m-2">
                        <i class="bi bi-info-circle"></i>
                    </a>
                    <a asp-controller="Biblioteca" asp-action="Editar" asp-route-id="@item.Id" title="Editar" class="m-2">
                        <i class="bi bi-pencil"></i>
                    </a>
                    <a href="" data-bs-toggle="modal" data-bs-target="#ModalDelecao_@item.Id" class="m-2" title="Excluir">
                        <i class="bi bi-trash"></i>
                    </a>
                </td>
            </tr>

            <div class="modal fade" id="Modal_@item.Id" tabindex="-1" aria-labelledby="modalDetalhesLabel_@item.Id" aria-hidden="true">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h1 class="modal-title fs-5" id="modalDetalhesLabel_@item.Id">Detalhes do Livro</h1>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <p class="text-center">Título: @item.Titulo</p>
                            <p class="text-center">Autor: @item.Autor</p>
                            <p class="text-center">ISBN: @item.ISBN</p>
                            <p class="text-center">Ano de Publicação: @item.AnoPublicacao</p>
                            <p class="text-center">Nota: @((int)item.NotaDoLivro)</p>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fechar</button>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal fade" id="ModalDelecao_@item.Id" tabindex="-1" aria-labelledby="modalDelecaoLabel_@item.Id" aria-hidden="true">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h1 class="modal-title fs-5" id="modalDelecaoLabel_@item.Id">Confirmar Exclusão</h1>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <h3 class="text-center">Deseja apagar o livro: @item.Titulo?</h3>
                            <span class="text-danger">A ação não pode ser desfeita após a confirmação!</span>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fechar</button>
                            <form asp-action="Apagar" asp-controller="Biblioteca" asp-route-id="@item.Id" method="post">
                                <button type="submit" class="btn btn-danger">Confirmar</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </tbody>
</table>